# ---------------------------------------------------------------------------
# ASPEN Environment Variables Template
# ---------------------------------------------------------------------------

# Admin users (JSON string)
ADMIN_USERS='[{"phone":"024XXXXXXX","password":"Admin@123","name":"Admin User","region":"Ashanti","district":"Kumasi Metropolitan","town":"Kumasi"}]'

# SMS Provider (africastalking)
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_ENDPOINT=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_SENDER_ID=ASPEN

# Demo mode: true = simulated SMS, false = real provider
DEMO_MODE=true

# Database (default SQLite)
DATABASE_URL=sqlite:///aspen.db

# JWT Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Reverse Geocoding
NOMINATIM_USER_AGENT=ASPEN_Engine/1.0
NOMINATIM_TIMEOUT=2.0

# Engine Parameters
DISPATCH_BUFFER_HOURS=1.5
AVG_SPEED_KMPH=30.0
W_DISTANCE=0.6
W_FRESHNESS=0.4
GLOBAL_D_MAX_KM=200.0
GLOBAL_L_MAX_HOURS=72.0

# Scheduler Intervals (minutes)
SCHEDULER_INTERVAL_MINUTES=1
ENGINE_INTERVAL_MINUTES=10

# Multi‑Phase Workflow Timings
STALE_MATCH_TIMEOUT_MINUTES=120
ACCEPTANCE_WINDOW_MINUTES=120
DISPATCH_WINDOW_MINUTES=120
DELIVERY_TRAVEL_MULTIPLIER=2.5
INSPECTION_BUFFER_HOURS=6.0
MIN_DELIVERY_WINDOW_HOURS=12.0

# Trust Score
SPOILAGE_CLAIM_THRESHOLD_RATIO=0.4
SPOILAGE_CLAIM_MIN_ORDERS=5